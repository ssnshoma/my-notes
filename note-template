% ---------- طول‌های لازم برای گزینه‌ها ----------
\newlength{\ChoiceWidthOne}
\newlength{\ChoiceWidthTwo}
\newlength{\ChoiceWidthThree}
\newlength{\ChoiceWidthFour}
\newlength{\ChoicePairA}
\newlength{\ChoicePairB}

% ---------- چهارگزینه‌ای تطبیقی راست‌به‌چپ ----------
\NewDocumentCommand{\fourchoice}{m m m m}{%
	\par\vspace{1.5mm}%
	\begingroup
	\normalfont
	
	\settowidth{\ChoiceWidthOne}{(الف)\enspace #1}%
	\settowidth{\ChoiceWidthTwo}{(ب)\enspace #2}%
	\settowidth{\ChoiceWidthThree}{(ج)\enspace #3}%
	\settowidth{\ChoiceWidthFour}{(د)\enspace #4}%
	
	\setlength{\ChoicePairA}{\ChoiceWidthOne}%
	\ifdim\ChoiceWidthThree>\ChoicePairA
	\setlength{\ChoicePairA}{\ChoiceWidthThree}%
	\fi
	
	\setlength{\ChoicePairB}{\ChoiceWidthTwo}%
	\ifdim\ChoiceWidthFour>\ChoicePairB
	\setlength{\ChoicePairB}{\ChoiceWidthFour}%
	\fi
	
	% حالت 4 گزینه در یک سطر
	\ifdim\dimexpr
	\ChoiceWidthOne+\ChoiceWidthTwo+\ChoiceWidthThree+\ChoiceWidthFour+12mm
	\relax<\linewidth
	\noindent
	\begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}rrrr@{}}
		(الف)\enspace #1 &
		(ب)\enspace #2 &
		(ج)\enspace #3 &
		(د)\enspace #4
	\end{tabular*}
	\else
	% حالت 2 در 2
	\ifdim\dimexpr\ChoicePairA+\ChoicePairB+8mm\relax<\linewidth
	\noindent
	\begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}rr@{}}
		(الف)\enspace #1 & (ب)\enspace #2 \\
		[1.5mm]
		(ج)\enspace #3 & (د)\enspace #4
	\end{tabular*}
	\else
	% حالت تک‌ستونی
	\noindent\parbox[t]{\linewidth}{(الف)\enspace #1}\par\vspace{1mm}
	\noindent\parbox[t]{\linewidth}{(ب)\enspace #2}\par\vspace{1mm}
	\noindent\parbox[t]{\linewidth}{(ج)\enspace #3}\par\vspace{1mm}
	\noindent\parbox[t]{\linewidth}{(د)\enspace #4}\par
	\fi
	\fi
	
	\endgroup
	\vspace{1.5mm}%
}

